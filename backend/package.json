{
  "name": "premier-league-backend",
  "version": "1.0.0",
  "description": "Premier League Predictions Backend API",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run migrate:deploy && node dist/app.js",
    "migrate:deploy": "node dist/database/migrate.cli.js baseline",
    "migrate:status:prod": "node dist/database/migrate.cli.js status",
    "sync:prod": "node dist/cli/sync.cli.js",
    "dev": "nodemon src/app.ts",
    "migrate": "ts-node src/database/migrate.cli.ts up",
    "migrate:baseline": "ts-node src/database/migrate.cli.ts baseline",
    "migrate:status": "ts-node src/database/migrate.cli.ts status",
    "db:seed": "ts-node src/database/migrate.cli.ts seed",
    "db:reset": "ts-node src/database/migrate.cli.ts reset",
    "sync": "ts-node src/cli/sync.cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.5",
    "@types/node": "^20.5.0",
    "@types/pg": "^8.10.2",
    "@types/sequelize": "^4.28.20",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "vitest": "^2.1.9"
  }
}
