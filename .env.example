JWT_SECRET=replace-with-a-long-random-secret
DB_NAME=premier_league_predictions_dev
DB_USER=postgres
DB_PASSWORD=replace-with-a-local-development-password
DB_PORT=5432

# Football data sync (https://www.football-data.org/client/register for a free token).
# Leave FOOTBALL_SYNC_ENABLED=false to keep the scheduled jobs off; the
# `npm run sync` CLI works regardless.
FOOTBALL_API_KEY=
FOOTBALL_SYNC_ENABLED=false
FOOTBALL_COMPETITION=PL
# Blank means the provider's active season.
FOOTBALL_SEASON=
# Gameweeks ahead of the current one that the schedule sync may write.
FOOTBALL_SYNC_GAMEWEEK_HORIZON=3
# How often the results poller ticks. Ticks outside a finish window make no
# API call, so this costs nothing on an idle day.
FOOTBALL_SYNC_RESULTS_INTERVAL_SECONDS=300
# Confirm a newly final score on a separate tick after the provider has had
# time to apply late score corrections.
FOOTBALL_RESULT_VERIFICATION_INTERVAL_SECONDS=30
FOOTBALL_RESULT_VERIFICATION_DELAY_SECONDS=90
# Results are polled only between these minutes after kickoff. A match in
# progress is never polled, because a score is written only when it is final.
FOOTBALL_FINISH_WINDOW_START_MINUTES=95
FOOTBALL_FINISH_WINDOW_END_MINUTES=240
